{
  "entities": {
    "CloudTrack": {
      "title": "CloudTrack",
      "description": "Metadata and lyrics for an audio file uploaded to the user's private Firebase cloud library.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "album": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "year": {
          "type": "integer"
        },
        "duration": {
          "type": "number"
        },
        "format": {
          "type": "string",
          "maxLength": 16,
          "enum": ["mp3", "wav", "flac", "aac", "m4a", "ogg", "opus", "unknown"]
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fileSize": {
          "type": "integer"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "duplicateKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "language": {
          "type": "string",
          "maxLength": 32,
          "enum": ["Tamil", "English", "Hindi", "Malayalam", "Telugu", "Instrumental", "Other"]
        },
        "moods": {
          "type": "array"
        },
        "energy": {
          "type": "number"
        },
        "chunkCount": {
          "type": "integer"
        },
        "hasArtwork": {
          "type": "boolean"
        },
        "artworkDataUrl": {
          "type": "string",
          "maxLength": 150000
        },
        "embeddedLyrics": {
          "type": "string",
          "maxLength": 50000
        },
        "lrcContent": {
          "type": "string",
          "maxLength": 50000
        },
        "isFavorite": {
          "type": "boolean"
        },
        "playCount": {
          "type": "integer"
        },
        "skipCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "artist",
        "album",
        "genre",
        "duration",
        "format",
        "mimeType",
        "fileSize",
        "fileName",
        "duplicateKey",
        "language",
        "moods",
        "energy",
        "chunkCount",
        "hasArtwork",
        "isFavorite",
        "playCount",
        "skipCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "AudioChunk": {
      "title": "AudioChunk",
      "description": "Base64-encoded binary slice of a user's uploaded audio file stored in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "index": {
          "type": "integer"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 460000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "trackId", "index", "data", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/cloudTracks/{trackId}": {
      "schema": {
        "$ref": "#/entities/CloudTrack"
      },
      "description": "User-owned cloud music track metadata and optional lyrics/cover art."
    },
    "/users/{userId}/cloudTracks/{trackId}/chunks/{chunkId}": {
      "schema": {
        "$ref": "#/entities/AudioChunk"
      },
      "description": "Ordered base64 audio chunks belonging to a parent CloudTrack document."
    }
  }
}
